# Postgres connection used by the Prisma CLI (migrate/studio/seed). This is
# the bootstrap superuser role (matches docker-compose.yml defaults) — it
# needs elevated privileges to create tables/policies.
DATABASE_URL="postgresql://cloudshiftg:cloudshiftg@localhost:5432/cloudshiftg?schema=public"

# Postgres connection used by the running application at runtime. This is a
# separate, unprivileged role (created by db/init/01-create-app-role.sql) so
# that row-level security policies actually apply to it — the bootstrap
# superuser above always bypasses RLS, so the app must never use it directly.
APP_DATABASE_URL="postgresql://cloudshiftg_app:cloudshiftg_app@localhost:5432/cloudshiftg?schema=public"

# iron-session cookie encryption key (>= 32 characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# Platform Operator account, created by `npm run prisma:seed` — the one role
# that can never self-register (no tenant of their own). Tenant Admins are
# created via the self-service registration flow at /register.
PLATFORM_OPERATOR_EMAIL="operator@example.com"
PLATFORM_OPERATOR_PASSWORD="ChangeMe123!"
PLATFORM_OPERATOR_NAME="Platform Operator"

# Optional: AWS credentials for CloudShift-G's own IAM identity, used only to
# call sts:AssumeRole against tenant-provided role ARNs. Leave unset for local
# dev — the app falls back to a clearly-labeled simulated dev adapter.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1

# Optional: Cost Explorer's GetCostAndUsage costs a small real fee per call
# and needs up to 24h to populate on a fresh account, so it's never called
# just because AWS credentials are configured above. Set to "true" to opt in.
# AWS_COST_EXPLORER_ENABLED=

# Optional: an API key for a GCP project with the "Cloud Billing API" enabled,
# used only to read public GCP list pricing (Cloud Billing Catalog API) for
# the AWS -> GCP cost comparison feature. This is global public pricing, not
# tied to any specific billing account — no OAuth/service account needed.
# Leave unset to use the simulated dev adapter for GCP pricing.
# GCP_BILLING_API_KEY=

# Required for the Terraform generation feature: the target GCP project ID
# that generated Terraform config targets, and that `terraform plan` runs
# against for real. No dev-adapter fallback here — generating GCP config
# with no target project is meaningless, not a "simulate vs real" choice.
# Terraform authenticates via your local `gcloud auth application-default
# login` session (Application Default Credentials) — no service-account key
# file is used or stored anywhere.
# GCP_PROJECT_ID=

# Job dispatch runtime for background work (audits, comparisons, terraform).
# - inline (default locally): run in-process via Next.js `after()`
# - pubsub: publish to Pub/Sub; run `npm run worker` (or the worker Deployment)
# - k8s-job: terraform/apply/rollback as Kubernetes Jobs; audits/comparisons still use Pub/Sub
# JOB_RUNTIME=inline
# PUBSUB_TOPIC_PREFIX=cloudshiftg
# TERRAFORM_JOB_IMAGE=
# K8S_NAMESPACE=development
