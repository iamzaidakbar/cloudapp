# Postgres connection used by the Prisma CLI (migrate/studio/seed). This is
# the bootstrap superuser role (matches docker-compose.yml defaults) — it
# needs elevated privileges to create tables/policies.
DATABASE_URL="postgresql://cloudshiftg:cloudshiftg@localhost:5432/cloudshiftg?schema=public"

# Postgres connection used by the running application at runtime. This is a
# separate, unprivileged role (created by db/init/01-create-app-role.sql) so
# that row-level security policies actually apply to it — the bootstrap
# superuser above always bypasses RLS, so the app must never use it directly.
APP_DATABASE_URL="postgresql://cloudshiftg_app:cloudshiftg_app@localhost:5432/cloudshiftg?schema=public"

# iron-session cookie encryption key (>= 32 characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# First Admin user, created by `npm run prisma:seed` (there is no signup flow).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Admin"

# Optional: AWS credentials for CloudShift-G's own IAM identity, used only to
# call sts:AssumeRole against tenant-provided role ARNs. Leave unset for local
# dev — the app falls back to a clearly-labeled simulated dev adapter.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
