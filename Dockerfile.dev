# Dev image for `docker compose up` — runs Next.js with hot reload.
# Production images remain Dockerfile / Dockerfile.worker / Dockerfile.terraform-job.
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
RUN npm ci

COPY scripts/docker-dev-entrypoint.sh /entrypoint.sh
# Host checkouts on Windows may save the script with CRLF; strip them for Linux.
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
