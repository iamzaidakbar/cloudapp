generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@map("admins")
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  FAILED
}

enum VerificationSource {
  AWS
  DEV_ADAPTER
}

// "Tenant" is the data-layer/AWS-account-boundary entity, not a UI role — the
// app remains Admin-only. Exactly one Tenant row exists per deployment,
// enforced in application code (POST /api/onboarding/tenant is 409 if one exists).
model Tenant {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  awsConnection  AwsConnection?
  auditRuns      AuditRun[]
  comparisonRuns ComparisonRun[]
  migrationPlans MigrationPlan[]
  terraformRuns  TerraformRun[]
  applyRuns      ApplyRun[]
  verificationRuns VerificationRun[]
  rollbackRuns   RollbackRun[]

  @@map("tenants")
}

model AwsConnection {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleArn               String?
  externalId            String
  awsAccountId          String?
  status                ConnectionStatus    @default(NOT_CONNECTED)
  verificationSource    VerificationSource?
  lastVerifiedAt        DateTime?
  lastVerificationError String?
  connectedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aws_connections")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ServiceCollectionStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingType {
  PUBLIC_S3_BUCKET
  UNENCRYPTED_EBS_VOLUME
  UNATTACHED_EBS_VOLUME
  UNDERUTILIZED_EC2_INSTANCE
  OVER_PROVISIONED_EC2_INSTANCE
  MISSING_TAGS
}

enum AwsServiceType {
  EC2_INSTANCE
  EBS_VOLUME
  SECURITY_GROUP
  VPC
  S3_BUCKET
  RDS_INSTANCE
  LAMBDA_FUNCTION
  ELB_LOAD_BALANCER
  IAM_ROLE
  CLOUDWATCH_LOG_GROUP
}

// Each AuditRun is a full point-in-time snapshot — every run inserts a fresh,
// complete set of AuditResource/AuditFinding rows rather than upserting a
// single "current state" table. Comparing historical runs is just reading two
// independent snapshots; no dedup/SCD logic needed. No generic Job table
// exists yet — status/progress live directly here since this is the only
// job-producing feature so far (revisit if Migrations/Comparisons need one).
model AuditRun {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  version    Int
  status     JobStatus          @default(QUEUED)
  dataSource VerificationSource

  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  resourceCount        Int?
  findingCount         Int?
  criticalFindingCount Int?
  estimatedMonthlyCost Decimal? @db.Decimal(12, 2)

  costDataAvailable        Boolean @default(false)
  utilizationDataAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceStatuses AuditServiceStatus[]
  resources       AuditResource[]
  findings        AuditFinding[]

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("audit_runs")
}

model AuditServiceStatus {
  id         String   @id @default(cuid())
  tenantId   String
  auditRunId String
  auditRun   AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  service       AwsServiceType
  status        ServiceCollectionStatus @default(PENDING)
  resourceCount Int                     @default(0)
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?

  @@unique([auditRunId, service])
  @@map("audit_service_statuses")
}

model AuditResource {
  id         String   @id @default(cuid())
  tenantId   String
  auditRunId String
  auditRun   AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  service     AwsServiceType
  resourceId  String // ARN or native id (vol-xxxx, i-xxxx, bucket name)
  name        String?
  region      String
  status      String? // AWS-native lifecycle status, free text (varies per service)
  environment String? // derived from an Environment/env tag if present
  tags        Json           @default("{}")
  rawConfig   Json // full describe-* payload

  monthlyCost   Decimal? @db.Decimal(12, 2)
  costAvailable Boolean  @default(false)

  cpuUtilizationAvgPercent Float? // EC2 only, when CloudWatch succeeds

  createdAt DateTime @default(now())

  findings AuditFinding[]

  @@unique([auditRunId, service, resourceId])
  @@index([tenantId, service])
  @@index([tenantId, region])
  @@map("audit_resources")
}

model AuditFinding {
  id         String   @id @default(cuid())
  tenantId   String
  auditRunId String
  auditRun   AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  resourceId String?
  resource   AuditResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  type        FindingType
  severity    FindingSeverity
  title       String
  description String
  remediation String?

  createdAt DateTime @default(now())

  @@index([tenantId, severity])
  @@index([auditRunId])
  @@map("audit_findings")
}

enum GcpDataSource {
  GCP
  DEV_ADAPTER
}

// Sourced from the latest SUCCEEDED AuditRun's resources — same
// point-in-time-snapshot / no-generic-Job-table reasoning as AuditRun above.
// Kept intentionally parallel in shape to AuditRun rather than unified into a
// shared Job table: this is only the 2nd job-producing feature, and a
// 2-call-site abstraction is exactly the premature-abstraction case this
// codebase avoids elsewhere (DataTableShell was introduced only once 2
// tables needed it). Migrations will be the 3rd job type — revisit then.
model ComparisonRun {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  version           Int
  status            JobStatus          @default(QUEUED)
  sourceAuditRunId  String
  awsDataSource     VerificationSource
  gcpDataSource     GcpDataSource

  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  itemCount               Int?
  totalAwsMonthlyCost     Decimal? @db.Decimal(12, 2)
  totalGcpLikeForLikeCost Decimal? @db.Decimal(12, 2)
  totalGcpOptimizedCost   Decimal? @db.Decimal(12, 2)
  costDataAvailable       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ComparisonItem[]

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("comparison_runs")
}

model ComparisonItem {
  id              String        @id @default(cuid())
  tenantId        String
  comparisonRunId String
  comparisonRun   ComparisonRun @relation(fields: [comparisonRunId], references: [id], onDelete: Cascade)

  auditResourceId String
  awsService      AwsServiceType
  awsResourceId   String
  awsResourceName String?
  region          String
  awsSizeLabel    String?

  gcpService   String
  gcpSizeLabel String?

  currentAwsMonthlyCost     Decimal? @db.Decimal(12, 2)
  gcpLikeForLikeMonthlyCost Decimal? @db.Decimal(12, 2)
  gcpOptimizedMonthlyCost   Decimal? @db.Decimal(12, 2)
  costAvailable             Boolean  @default(false)
  estimatedMigrationCost    Decimal? @db.Decimal(12, 2)

  performanceNotes String?

  createdAt DateTime @default(now())

  @@unique([comparisonRunId, awsResourceId])
  @@index([tenantId, awsService])
  @@map("comparison_items")
}

// Public list pricing, identical for every tenant — deliberately NOT
// tenant-scoped and NOT covered by row-level security (unlike every other
// table in this schema), same treatment as any other non-tenant reference
// data.
model PricingCache {
  id        String   @id @default(cuid())
  provider  String // "AWS" | "GCP"
  cacheKey  String
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([provider, cacheKey])
  @@index([expiresAt])
  @@map("pricing_cache")
}

enum MigrationPlanStatus {
  DRAFT
  APPROVED
  CANCELLED
  ROLLED_BACK
}

// Sourced from the latest SUCCEEDED ComparisonRun's items — deliberately NOT
// modeled as a job (no QUEUED/RUNNING/SUCCEEDED lifecycle, no AuditRun-style
// serviceStatuses): creating and approving a plan are synchronous DB writes,
// not background work. The generic-Job-table question this codebase has
// deferred twice becomes relevant again once actual Terraform
// execution/data-transfer exists (a real long-running job) — not here.
model MigrationPlan {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sequenceNumber        Int
  status                MigrationPlanStatus @default(DRAFT)
  sourceComparisonRunId String

  resourceCount           Int
  estimatedMigrationCost  Decimal? @db.Decimal(12, 2)
  estimatedAwsMonthlyCost Decimal? @db.Decimal(12, 2)
  estimatedGcpMonthlyCost Decimal? @db.Decimal(12, 2)
  costDataAvailable       Boolean  @default(false)

  approvedAt        DateTime?
  approvedByAdminId String?
  cancelledAt       DateTime?
  rolledBackAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources     MigrationResource[]
  terraformRuns TerraformRun[]
  applyRuns     ApplyRun[]
  verificationRuns VerificationRun[]
  rollbackRuns  RollbackRun[]

  @@unique([tenantId, sequenceNumber])
  @@index([tenantId, status])
  @@map("migration_plans")
}

model MigrationResource {
  id              String        @id @default(cuid())
  tenantId        String
  migrationPlanId String
  migrationPlan   MigrationPlan @relation(fields: [migrationPlanId], references: [id], onDelete: Cascade)

  comparisonItemId String // plain reference, not a relation — same convention as ComparisonItem.auditResourceId
  awsService       AwsServiceType
  awsResourceId    String
  awsResourceName  String?
  region           String
  awsSizeLabel     String?
  gcpService       String
  gcpSizeLabel     String?
  estimatedMigrationCost Decimal? @db.Decimal(12, 2)

  // Populated after a successful ApplyRun by matching this resource's
  // deterministic Terraform HCL address against the resulting state file —
  // the real live GCP resource, not a synthetic status enum.
  gcpResourceSelfLink String?
  provisionedAt       DateTime?

  createdAt DateTime @default(now())

  verificationChecks VerificationCheck[]

  @@unique([migrationPlanId, awsResourceId])
  @@index([tenantId, awsService])
  @@map("migration_resources")
}

enum TerraformRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// A real `terraform init`/`validate`/`plan` subprocess run against an
// APPROVED MigrationPlan's generated HCL. Deliberately NOT a generic Job
// table — same reasoning already documented on AuditRun/ComparisonRun: this
// is the 3rd job-shaped model, and each one's actual payload (findings vs.
// cost figures vs. generated HCL/plan text) differs enough that sharing a
// table would just mean a JSON blob for the type-specific part, losing real
// columns/FKs for no real gain. `apply`/`destroy` are never invoked by any
// code that produces or consumes this model — see lib/terraform/cli.ts.
model TerraformRun {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  migrationPlanId String
  migrationPlan   MigrationPlan @relation(fields: [migrationPlanId], references: [id], onDelete: Cascade)

  version Int
  status  TerraformRunStatus @default(QUEUED)

  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  terraformConfig String

  validateSucceeded Boolean?
  validateOutput    String?

  planSucceeded     Boolean?
  planOutput        String?
  resourcesToCreate Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([migrationPlanId, version])
  @@index([tenantId, status])
  @@map("terraform_runs")
}

enum ApplyRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// A real `terraform apply` against an APPROVED plan's already-validated,
// already-planned Terraform — this is the one model in the whole schema
// whose existence means real, billable GCP infrastructure was created.
// `destroy` is not invoked by any code that produces or consumes this model
// (see lib/terraform/cli.ts) — rollback is a distinct, later phase.
model ApplyRun {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  migrationPlanId String
  migrationPlan   MigrationPlan @relation(fields: [migrationPlanId], references: [id], onDelete: Cascade)

  version Int
  status  ApplyRunStatus @default(QUEUED)

  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  applyOutput      String?
  resourcesCreated Int?
  // Raw terraform.tfstate JSON — without this, anything apply creates would
  // be unmanageable by Terraform ever again (no future rollback possible).
  terraformState   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([migrationPlanId, version])
  @@index([tenantId, status])
  @@map("apply_runs")
}

enum VerificationStatus {
  HEALTHY
  UNHEALTHY
  UNAVAILABLE
}

// Deliberately synchronous, unlike every prior job-shaped model above: a
// verification check is a handful of fast GCP REST GETs (sub-few-seconds),
// not a real long-running process, so there's no QUEUED/RUNNING lifecycle
// here — a run is created with its checks already complete. Re-queries each
// resource's real live status at click time (via the same Application
// Default Credentials terraform apply already relies on, see lib/gcp/auth.ts)
// rather than trusting the ApplyRun's outcome from whenever it ran — those
// are different claims (created successfully once vs. healthy right now).
model VerificationRun {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  migrationPlanId String
  migrationPlan   MigrationPlan @relation(fields: [migrationPlanId], references: [id], onDelete: Cascade)

  version   Int
  checkedAt DateTime @default(now())

  checks VerificationCheck[]

  @@unique([migrationPlanId, version])
  @@index([tenantId])
  @@map("verification_runs")
}

model VerificationCheck {
  id                  String            @id @default(cuid())
  tenantId            String
  verificationRunId   String
  verificationRun     VerificationRun   @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)
  migrationResourceId String
  migrationResource   MigrationResource @relation(fields: [migrationResourceId], references: [id], onDelete: Cascade)

  status VerificationStatus
  // The real reported state string ("RUNNING", "RUNNABLE", "404 Not Found",
  // etc.) or error detail — never synthesized, always what GCP actually said.
  detail     String?
  checkedRef String? // the exact URL queried, for transparency

  @@index([tenantId, verificationRunId])
  @@map("verification_checks")
}

enum RollbackRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// A real `terraform destroy` against an APPROVED plan's persisted apply
// state — the one model whose existence means real GCP infrastructure was
// permanently torn down. `destroy` is invoked only from
// lib/terraform/cli.ts's terraformDestroy, reachable only through this
// model's full guard chain (see app/api/migrations/[id]/rollback/route.ts).
model RollbackRun {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  migrationPlanId String
  migrationPlan   MigrationPlan @relation(fields: [migrationPlanId], references: [id], onDelete: Cascade)

  version Int
  status  RollbackRunStatus @default(QUEUED)

  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  destroyOutput      String?
  resourcesDestroyed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([migrationPlanId, version])
  @@index([tenantId, status])
  @@map("rollback_runs")
}

enum AdminActionType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  TENANT_CREATED
  AWS_CONNECTION_UPDATED
  AWS_CONNECTION_VERIFIED
  AUDIT_STARTED
  COMPARISON_STARTED
  MIGRATION_PLAN_CREATED
  MIGRATION_APPROVED
  MIGRATION_CANCELLED
  TERRAFORM_GENERATED
  MIGRATION_APPLIED
  VERIFICATION_RUN
  MIGRATION_ROLLED_BACK
}

// Deliberately NOT tenant-scoped / NOT covered by row-level security — same
// treatment as PricingCache (see lib/pricing/cache.ts's own comment). Admin
// accounts have no tenantId (this app is Admin-only, not multi-tenant-per-
// role), and the very first action ever logged — an admin's first login —
// necessarily happens before any Tenant row exists. An RLS policy keyed on
// tenantId would make that row permanently invisible through the normal app
// connection (NULL never satisfies tenantId = current_setting(...)).
// tenantId is still stored, nullable, for context once a tenant exists.
model AdminActionLog {
  id         String           @id @default(cuid())
  tenantId   String?
  adminId    String? // null for a failed login — no authenticated admin yet
  adminEmail String // denormalized snapshot: survives the admin record changing, captures the attempted email even on a failed login
  action     AdminActionType
  targetType String? // e.g. "MigrationPlan" — plain text, not a relation
  targetId   String?
  detail     Json? // small, action-specific context — never secrets (externalId, passwords)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
  @@map("admin_action_logs")
}
